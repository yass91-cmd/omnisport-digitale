OMNI_ENVIRONMENT=development
OMNI_HTTP_PORT=8000
OMNI_DB_HOST=127.0.0.1
OMNI_DB_PORT=3307
OMNI_DB_NAME=omnisport
OMNI_DB_USER=omnisport
OMNI_DB_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD
OMNI_DB_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LOCAL_PASSWORD
# Optional auth settings; defaults support the local app on ports 8000/8001.
# Set explicit HTTPS origins and secure cookies when preparing production.
OMNI_COOKIE_SECURE=false
OMNI_AUTH_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:8001","http://localhost:8001"]
